{
  "name": "obsidian-family-tree-canvas",
  "version": "1.9.7",
  "description": "Lay out a family tree on a canvas in Obsidian.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --format=cjs --target=es2020 --minify --charset=utf8 --external:obsidian --outfile=main.js",
